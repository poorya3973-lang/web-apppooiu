{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-apppooiu",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "04e216d8-f194-4614-ac82-7caea788427a","database_name": "web-appvgftyt" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "4d1f76679c7f48c18a3010013535fb4d" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
